# 从阿里云百炼控制台获取密钥。本文件复制为 .env 后填写，禁止提交真实密钥。
DASHSCOPE_API_KEY=
# 可按控制台提供的网关填写工作空间和地域；为空时使用北京传统 DashScope 网关。
QWEN_WORKSPACE_ID=
QWEN_REGION=cn-beijing
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_RERANK_MODEL=qwen3-rerank
QWEN_SEARCH_MODEL=qwen-plus
QWEN_TIMEOUT=90
# 如控制台提供单独地址，取消下面注释并填入；地域必须与 API Key 一致。
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_NATIVE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 若 qwen3-rerank 不可用，可改 QWEN_RERANK_MODEL=gte-rerank-v2
# APP_DATA_DIR=/absolute/path/to/persistent-data
